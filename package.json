{
  "name": "@hoshinotatsuya/pg-saga",
  "version": "0.4.1",
  "description": "Saga orchestration on plain PostgreSQL on top of a transactional outbox: typed steps with compensations, instance state committed in the same transaction as the step's writes and the next command, retries with backoff, step timeouts, reverse-order compensation and manual repair of stuck instances.",
  "keywords": [
    "saga",
    "postgres",
    "postgresql",
    "outbox",
    "inbox",
    "orchestration",
    "compensation",
    "distributed-transactions",
    "drizzle",
    "transactional-outbox"
  ],
  "license": "MIT",
  "author": "Hoshino_Tatsuya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoshinoTatsuya/pg-saga.git"
  },
  "homepage": "https://github.com/HoshinoTatsuya/pg-saga#readme",
  "bugs": {
    "url": "https://github.com/HoshinoTatsuya/pg-saga/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "saga-stuck": "./dist/cli/saga-stuck.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/emit-esm-types.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json && node scripts/check-readme-examples.cjs",
    "lint": "biome check src",
    "test": "scripts/with-postgres.sh jest-groups --out .jest-report.json -- node_modules/.bin/jest && jest-assert-no-skipped .jest-report.json",
    "test:consumers": "scripts/consumer-matrix.sh",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run test:consumers && pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@hoshinotatsuya/outbox": "^0.6.0 || ^0.7.0 || ^0.8.0",
    "@hoshinotatsuya/pg-runtime": "^0.7.1 || ^0.8.0 || ^0.9.0",
    "@types/pg": ">=8.15.0",
    "drizzle-orm": ">=0.45.2 <0.46",
    "pg": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "@types/pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@hoshinotatsuya/arch-gates": "^0.12.2",
    "@hoshinotatsuya/fault-kit": "^0.3.1",
    "@hoshinotatsuya/jest-groups": "^0.7.2",
    "@hoshinotatsuya/outbox": "0.8.1",
    "@hoshinotatsuya/pg-runtime": "0.9.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.15",
    "@types/pg": "8.23.1",
    "drizzle-orm": "0.45.2",
    "jest": "30.5.2",
    "pg": "8.18.0",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3"
  }
}
